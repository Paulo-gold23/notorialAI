# ===============================
# Notorial.ai — Root .gitignore
# ===============================

# Environment & Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/
*.egg

# Node
node_modules/
dist/
dist-ssr/
*.local

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/

# OS
*.tmp
*.bak
*.swp
*~

# Agent/AI folders (dev only)
.agent/

# Specific app exclusions
notorial-api/app.log*
notorial-api/debug_pdf_preview.html
notorial-web/lint_output.txt
test_archives/
