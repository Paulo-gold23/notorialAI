{
    email {$ACME_EMAIL:contato@legisvox.com}
    admin off
}

# ── Bloco Principal (TLS automático via Let's Encrypt quando DOMAIN=legisvox.com) ──
{$DOMAIN} {
    # Headers de Segurança (HSTS + CSP + hardening)
    header {
        # HSTS — força HTTPS por 1 ano, previne SSL stripping
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # CSP — controla quais recursos o navegador pode carregar
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://status.supabase.com https://accounts.google.com https://static.cloudflareinsights.com; img-src 'self' data: blob:; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self';"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        -Server
    }

    # Compressão de alta performance
    encode zstd gzip

    # Cache agressivo para assets estáticos com hashes imutáveis do Vite
    @static path /assets/* *.js *.css *.png *.svg *.ico *.woff2 *.woff
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Roteamento da API FastAPI e Healthcheck
    @api path /api/* /health /health/*
    handle @api {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up CF-Connecting-IP {header.CF-Connecting-IP}
        }
    }

    # Roteamento do Frontend SPA
    handle {
        reverse_proxy web:8080
    }
}

