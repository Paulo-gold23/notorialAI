# Backend Environment Variables
# Copy this file to .env and fill in your real values

# Database (Use Port 6543 for Supavisor Connection Pooling in production to prevent connection exhaustion)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (port 5432 - for migrations only)
# DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (Whisper transcription)
GROQ_API_KEY=gsk_your-groq-key-here

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# PDF Converter Service (Internal Gotenberg container)
PDF_CONVERTER_URL=http://gotenberg:3000/forms/chromium/convert/html

# Environment (production | development)
ENVIRONMENT=production

# SMTP / E-mail configuration (for signature PIN recovery)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@legisvox.com.br

# CPF/CNPJ hashing secret (HMAC key — generate a unique random string, DO NOT CHANGE after first use)
CPF_HASH_SECRET=your-unique-random-secret-here
