# Backend Environment Variables
# Copy this file to .env and fill in your real values

# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Groq (Whisper transcription)
GROQ_API_KEY=gsk_your-groq-key-here

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# PDF Converter Service (Gotenberg)
PDF_CONVERTER_URL=http://your-pdf-service:3010/forms/chromium/convert/html

# Asaas Payment Gateway
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=your-webhook-secret-token

# Development Settings (DO NOT set to true in production)
ALLOW_TEST_BYPASS=false

