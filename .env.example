# ── Supabase (obrigatório para o frontend) ────────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ── Frontend API URL (deixe vazio para usar paths relativos em produção) ──────
VITE_API_URL=
