{
    email {$ACME_EMAIL:contato@legisvox.com}
    admin off
    auto_https disable_redirects
}

# Catch-all para qualquer IP ou Domínio em HTTP e HTTPS
http://, https:// {
    tls internal

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(self), geolocation=()"
        -Server
    }

    encode zstd gzip

    # Roteamento de API e Healthcheck -> FastAPI
    @api path /api/* /health /health/*
    handle @api {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up CF-Connecting-IP {header.CF-Connecting-IP}
        }
    }

    # Roteamento do Frontend SPA -> Nginx
    handle {
        reverse_proxy web:80
    }
}
